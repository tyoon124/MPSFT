reset_timestep  0
velocity        all create ${T} ${seed} dist gaussian
velocity        all create 2500 ${seed} dist gaussian
velocity        all create 2500 20261 dist gaussian
timestep        0.25
fix             nvt all nvt temp ${T} ${T} 25.0
fix             nvt all nvt temp 2500 ${T} 25.0
fix             nvt all nvt temp 2500 2500 25.0
variable        p equal press
fix             pr all ave/time 20 50 1000 v_p file pressure.dat    # pressure (atm), 1000-step averages
# atom types: 1 = C, 2 = H, 3 = O.  Connectivity is derived from the interatomic distances in the analysis script.
dump            traj all custom 200 traj.lammpstrj id type x y z      # every 50 fs
dump_modify     traj sort id
thermo          4000
run             ${nsteps}
run             120000
