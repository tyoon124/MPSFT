LAMMPS (22 Jul 2025 - Update 3)
# Example 7.3 (T* = 1.50) -- attractive solute in a Lennard-Jones solvent on the critical isochore (reduced units)
# 3 solute atoms (type 2) + 3997 solvent atoms (type 1) in a cubic periodic box (10 x 10 x 10 fcc cells, 23.2 sigma) at
# rho* = 0.32 (total number density). Compared with the first set of runs (2048 atoms, 8 solutes), the box is larger and
# the solutes are fewer, so that the excess-solvent clouds of the solutes do not overlap (infinite-dilution limit) and
# the excess number N_exc(R) can be followed to larger R.
# usage:  lmp -in in.solute                    (run inside the folder T<value>/; T is set below)
units           lj
atom_style      atomic
boundary        p p p

variable        T       index 1.50
variable        rho     index 0.32
variable        seed    index 20262
variable        ncell   index 10         # fcc cells per box edge: 4 ncell^3 atoms
variable        nsol    index 3          # number of solute atoms (0.075 % of all atoms: dilute limit)
variable        esv     index 1.5        # solute-solvent well depth (solvent-solvent = 1)
variable        ssol    index 1.2        # solute diameter (solvent = 1)
variable        rcut    index 4.0
variable        nequil  index 400000     # 2e3 time units
variable        nprod   index 3000000    # 1.5e4 time units = 30 blocks of 1e5 steps

# 10 x 10 x 10 fcc cells = 4000 atoms (the lattice melts at once at T* > T_c)
lattice         fcc ${rho}
lattice         fcc 0.32
Lattice spacing in x,y,z = 2.3207944 2.3207944 2.3207944
region          box block 0 ${ncell} 0 ${ncell} 0 ${ncell}
region          box block 0 10 0 ${ncell} 0 ${ncell}
region          box block 0 10 0 10 0 ${ncell}
region          box block 0 10 0 10 0 10
create_box      2 box
Created orthogonal box = (0 0 0) to (23.207944 23.207944 23.207944)
  2 by 2 by 2 MPI processor grid
create_atoms    1 box
Created 4000 atoms
  using lattice units in orthogonal box = (0 0 0) to (23.207944 23.207944 23.207944)
  create_atoms CPU = 0.000 seconds
set             group all type/subset 2 ${nsol} ${seed}
set             group all type/subset 2 3 ${seed}
set             group all type/subset 2 3 20262
Setting atom values ...
  3 settings made for type/subset
mass            * 1.0

pair_style      lj/cut ${rcut}
pair_style      lj/cut 4.0
pair_coeff      1 1 1.0 1.0
pair_coeff      2 2 1.0 ${ssol}
pair_coeff      2 2 1.0 1.2
pair_coeff      1 2 ${esv} $(0.5*(1.0+v_ssol))
pair_coeff      1 2 1.5 $(0.5*(1.0+v_ssol))
pair_coeff      1 2 1.5 1.1000000000000000888
pair_modify     shift yes
neighbor        0.3 bin
comm_modify     cutoff 10.5     # ghost atoms for the 10 sigma range of the RDF
timestep        0.005

velocity        all create ${T} ${seed} dist gaussian
velocity        all create 1.50 ${seed} dist gaussian
velocity        all create 1.50 20262 dist gaussian
fix             nvt all nvt temp ${T} ${T} 0.5
fix             nvt all nvt temp 1.50 ${T} 0.5
fix             nvt all nvt temp 1.50 1.50 0.5
thermo          10000
thermo_style    custom step temp pe press density
run             ${nequil}
run             400000
Generated 0 of 1 mixed pair_coeff terms from geometric mixing rule
