reset_timestep  0
# production: solvent-solute (1-2) and solvent-solvent (1-1) radial distribution functions up to 10 sigma
# (the box is 23.2 sigma), averaged over 30 blocks of 1e5 steps = 500 time units (sampled every 1000 steps)
compute         rdf all rdf 200 1 2 1 1 cutoff 10.0
fix             rdfout all ave/time 1000 100 100000 c_rdf[*] file rdf.dat mode vector
variable        p equal press
fix             pr all ave/time 100 1 100 v_p file pressure.dat
thermo          100000
run             ${nprod}
run             3000000
