# ======================================================================
# Example 5.5: NpT simulation of the Lennard-Jones fluid on an isobar.
# Generated by generate_example5_5_inputs.py   (N=500, T*=1.400, p*=0.150)
# Output: time series of volume and enthalpy (run_series.dat) for the
#         fluctuation route and for the finite-difference route.
# Run:  lmp -in in.run
# ======================================================================

# ----------------------------- SETTINGS -------------------------------
variable N       equal 500      # number of atoms
variable Tstar   equal 1.4000      # reduced temperature
variable Pstar   equal 0.1500      # reduced pressure
variable rho0    equal 0.25     # density of the initial box
variable rc      equal 5.0       # cutoff radius (sigma); tail corrections are added
variable dt      equal 0.005     # time step (reduced units)
variable seed    equal 12351     # random seed
variable Tdamp   equal 0.5       # thermostat damping time
variable Pdamp   equal 5.0       # barostat damping time
variable nequil  equal 100000   # equilibration steps
variable nprod   equal 400000  # production steps
variable nsample equal 100   # sampling interval (steps)
variable tag     string run      # prefix of the output files
# ----------------------------------------------------------------------

units           lj
atom_style      atomic
boundary        p p p
variable        L equal (${N}/${rho0})^(1.0/3.0)
region          box block 0 ${L} 0 ${L} 0 ${L}
create_box      1 box
create_atoms    1 random ${N} ${seed} box overlap 0.8 maxtry 5000
mass            1 1.0

pair_style      lj/cut ${rc}
pair_coeff      1 1 1.0 1.0
pair_modify     tail yes
neighbor        0.3 bin
neigh_modify    every 1 delay 0 check yes
timestep        ${dt}

# remove overlaps and start from the target temperature
velocity        all create ${Tstar} ${seed} mom yes rot no dist gaussian
fix             relax all nve/limit 0.05
thermo          1000
run             2000
unfix           relax

# equilibration in the NpT ensemble
fix             npt all npt temp ${Tstar} ${Tstar} ${Tdamp} iso ${Pstar} ${Pstar} ${Pdamp}
thermo_style    custom step temp pe press vol density
thermo_modify   norm no
thermo          10000
run             ${nequil}

# production: H = E + p V with the TARGET pressure (not the instantaneous one)
variable        Hinst  equal etotal+${Pstar}*vol
variable        Vinst  equal vol
variable        Einst  equal pe
variable        Pinst  equal press
variable        Tinst  equal temp
fix             out all print ${nsample} "$(step) ${Vinst} ${Hinst} ${Einst} ${Pinst} ${Tinst}" &
                file ${tag}_series.dat screen no title "# step V H pe P T"
run             ${nprod}
write_data      ${tag}_final.data
