# Lennard-Jones fluid, NVT, reduced units (epsilon = sigma = m = k_B = 1)
# Example 5.1: radial distribution function g(r) at T* = 1.40, rho* = 0.10

# ---------------- parameters ----------------
variable     rho    index 0.25          # reduced number density
variable     T      index 1.40          # reduced temperature
variable     dt     index 0.002         # reduced time step
variable     rc     index 3.0           # LJ cutoff (sigma); tail correction added
variable     neq    index 2500000       # equilibration steps  (5000 tau)
variable     nprod  index 20000000      # production steps     (40000 tau)
variable     ndump  index 10000         # dump interval (steps) -> nprod/ndump frames
variable     nsamp  index 1000          # on-the-fly g(r) sampling interval (steps)
variable     dr     index 0.01          # g(r) bin width (sigma)

# N = 10^3 = 1000 atoms on a simple cubic lattice, box edge L = (N/rho)^(1/3)
variable     L      equal 10.0*${rho}^(-1.0/3.0)
variable     rmax   equal 0.5*${L}                 # g(r) is defined up to L/2
variable     nbin   equal floor(${rmax}/${dr})

# ---------------- system ----------------
units        lj
boundary     p p p
atom_style   atomic

lattice      sc ${rho}
region       box block 0 10 0 10 0 10
create_box   1 box
create_atoms 1 box
mass         1 1.0

pair_style   lj/cut ${rc}
pair_modify  tail yes
pair_coeff   1 1 1.0 1.0

neighbor     0.3 bin
neigh_modify every 1 delay 0 check yes one 6000 binsize 0.0
kspace_style none

velocity     all create ${T} 1 rot yes mom yes dist gaussian

# ---------------- equilibration (the lattice melts) ----------------
print        "*** NVT equilibration"
variable     Tdamp equal 100.0*${dt}
fix          NVT all nvt temp ${T} ${T} ${Tdamp}
timestep     ${dt}
thermo_style custom step temp density press pe
thermo       100000
run          ${neq}

# ---------------- production ----------------
print        "*** NVT production"
reset_timestep 0

# running averages of thermodynamic properties (every 1000 steps)
compute      myKE all ke
compute      myPE all pe
variable     etotal equal c_myKE+c_myPE
fix          avgP all ave/time 100 10 1000 c_thermo_press file avg_press_rho${rho}.txt ave running
fix          avgU all ave/time 100 10 1000 v_etotal       file avg_U_rho${rho}.txt     ave running
fix          avgT all ave/time 100 10 1000 c_thermo_temp  file avg_T_rho${rho}.txt     ave running

# on-the-fly g(r) and coordination number, averaged over the whole production run
variable     rcomm equal ${rmax}+0.4               # rdf cutoff + neighbor skin must fit in the ghost-atom range
comm_modify  cutoff ${rcomm}
compute      rdf all rdf ${nbin} cutoff ${rmax}
variable     nrep equal ${nprod}/${nsamp}
fix          RDF all ave/time ${nsamp} ${nrep} ${nprod} c_rdf[*] file rdf_rho${rho}.dat mode vector

# trajectory for post-processing (wrapped coordinates)
dump         traj all custom ${ndump} traj_rho${rho}.lammpstrj id type x y z
dump_modify  traj sort id format line "%d %d %.6f %.6f %.6f"

thermo_style custom step temp pe press density
thermo       ${ndump}
run          ${nprod}

write_data   final_rho${rho}.data
