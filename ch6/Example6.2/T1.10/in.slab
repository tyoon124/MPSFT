# Example 6.2 (T* = 1.10) -- liquid-vapor slab of the Lennard-Jones fluid (reduced units), interface normal along x
# usage:  lmp -in in.slab                      (run inside the folder T<value>/; T is set below)
units           lj
atom_style      atomic
boundary        p p p

variable        T       index 1.10
variable        seed    index 20251
variable        rcut    index 4.0
variable        Tmelt   index 1.0       # melt the lattice below T_c so that the slab stays intact
variable        nmelt   index 5000
variable        nequil  index 1000000
variable        nprod   index 2000000    # 1e4 reduced time units after 5e3 tau of equilibration

# 23 x 5 x 5 fcc cells at rho* = 0.746 -> box 40.3 x 8.75 x 8.75 sigma; liquid slab = 12 cells (21 sigma)
lattice         fcc 0.746
region          box  block 0 23 0 5 0 5 units lattice
create_box      1 box
region          slab block 5 17 0 5 0 5 units lattice
create_atoms    1 region slab
mass            1 1.0

pair_style      lj/cut ${rcut}
pair_coeff      1 1 1.0 1.0
pair_modify     shift yes            # no tail corrections: the density is inhomogeneous (Sec. 4.6.2)
neighbor        0.3 bin
timestep        0.005

velocity        all create ${Tmelt} ${seed} dist gaussian
fix             melt all nvt temp ${Tmelt} ${Tmelt} 0.5
thermo          1000
run             ${nmelt}
unfix           melt

fix             nvt all nvt temp ${T} ${T} 0.5
run             ${nequil}

reset_timestep  0
# production: pressure tensor every 100 steps and the density profile along x (bin 0.5 sigma)
variable        pxx equal pxx
variable        pyy equal pyy
variable        pzz equal pzz
fix             pt all print 100 "${pxx} ${pyy} ${pzz}" file pressure.dat screen no title "pxx pyy pzz"
compute         cx all chunk/atom bin/1d x lower 0.5 units box
fix             prof all ave/chunk 10 1000 10000 cx density/number file profile.dat
thermo          10000
thermo_style    custom step temp pe press pxx pyy pzz density
run             ${nprod}
